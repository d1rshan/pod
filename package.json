{
  "name": "pod",
  "version": "0.1.0",
  "description": "A tiny iPod-style Apple Music player",
  "license": "GPL-3.0-only",
  "author": "d1rshan",
  "repository": "github:d1rshan/pod",
  "desktopName": "pod.desktop",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -w",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "dist": "electron-vite build && electron-builder --linux",
    "test": "bun test",
    "bench": "bun scripts/bench.ts",
    "check": "bun run typecheck && bun test && bun run build",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "svelte": "^5.58.1",
    "svelte-check": "^4.7.8",
    "typescript": "5",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "dev.pod.app",
    "productName": "pod",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icons",
      "synopsis": "A tiny iPod-style Apple Music player",
      "syncDesktopName": true
    },
    "electronVersion": "45.2.1+wvcus",
    "artifactName": "pod-${arch}.${ext}",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": null
  }
}
